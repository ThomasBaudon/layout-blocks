{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "thomasbaudon/linked-card",
  "version": "0.1.0",
  "title": "Carte cliquable",
  "category": "design",
  "icon": "id-alt",
  "description": "Un conteneur dont toute la surface est cliquable, avec le contenu de ton choix.",
  "textdomain": "layout-blocks",
  "usesContext": [
    "postId"
  ],
  "attributes": {
    "url": {
      "type": "string",
      "default": ""
    },
    "opensInNewTab": {
      "type": "boolean",
      "default": false
    },
    "usePostLink": {
      "type": "boolean",
      "default": false
    },
    "ariaLabel": {
      "type": "string",
      "default": ""
    },
    "hoverEffect": {
      "type": "string",
      "default": "none"
    },
    "overlayColor": {
      "type": "string",
      "default": ""
    },
    "customOverlayColor": {
      "type": "string",
      "default": ""
    },
    "overlayOpacity": {
      "type": "number",
      "default": 50
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "background": {
      "backgroundImage": true,
      "backgroundSize": true
    },
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "dimensions": {
      "minHeight": true
    },
    "layout": true
  },
  "styles": [
    {
      "name": "default",
      "label": "Par défaut",
      "isDefault": true
    },
    {
      "name": "outlined",
      "label": "Contour"
    },
    {
      "name": "elevated",
      "label": "Surélevée"
    }
  ],
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}